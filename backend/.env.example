JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=sqlite:///./data/campus.db
# Local campus timezone used for API timestamps and input dates without an offset.
APP_TIMEZONE=Africa/Nairobi
MEDIA_DIR=./data/media
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional comma-separated campus email domains. Empty allows any email domain.
CAMPUS_EMAIL_DOMAINS=
# JSON array of allowed frontend origins.
CORS_ORIGINS=[]
ACCESS_TOKEN_MINUTES=30
MAX_UPLOAD_BYTES=10485760
